# Copy to secrets.toml (local) or paste into Streamlit Community Cloud's
# "Advanced settings → Secrets" panel when deploying.
SNOWFLAKE_USER = "your_user"
SNOWFLAKE_PASSWORD = "your_password"
SNOWFLAKE_ACCOUNT = "your_account_identifier"   # e.g. "AB12345-XY67890"
SNOWFLAKE_WAREHOUSE = "COMPUTE_WH"
SNOWFLAKE_ROLE = "ACCOUNTADMIN"
SNOWFLAKE_DATABASE = "US_OPEN_CENSUS_DATA__NEIGHBORHOOD_INSIGHTS__FREE_DATASET"

ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-4-6"

QUERY_ROW_LIMIT = "200"
QUERY_TIMEOUT_SECONDS = "30"
